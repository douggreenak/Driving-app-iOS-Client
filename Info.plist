<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<!-- Enables ActivityKit Live Activities (trip progress on the Lock Screen / Dynamic Island). -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Injected at build time from Secrets.xcconfig (API_KEY); never hard-coded here. -->
	<key>APIKey</key>
	<string>$(API_KEY)</string>
	<!-- Lets the Live Activity (Lock Screen / Dynamic Island) deep-link back into the app at the
	     live tracking screen — see DriveActivityLiveActivity's .widgetURL and ContentView's
	     .onOpenURL. Without this, tapping the activity just opens the app on whatever tab was last
	     selected, with no way to tell the currently-tracking drive is still minimized underneath. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.drivetracker.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>drivetracker</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
